<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#15171C" />
        </shape>
    </item>
    <!-- A small red light, struck out -->
    <item android:gravity="center" android:width="44dp" android:height="44dp">
        <shape android:shape="oval">
            <solid android:color="#3A1414" />
            <stroke android:width="3dp" android:color="#C83C3C" />
        </shape>
    </item>
    <item android:gravity="center" android:width="70dp" android:height="4dp">
        <rotate android:fromDegrees="-35" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="rectangle"><solid android:color="#E6E6E6" /></shape>
        </rotate>
    </item>
</layer-list>
